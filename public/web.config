<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS host config for the Sila web app (static files only).
  The app calls the APIs directly: the Sila API at https://sila.glcpaints.com:7400
  (src/shared/auth.js) and the Files API at https://sila.glcpaints.com:7500
  (src/shared/files.js), so no reverse proxy is needed here.
  Kept minimal on purpose: only sections a site may set on a default IIS
  (no URL Rewrite, no caching / httpErrors / httpCompression sections). IIS 10
  already serves .js / .json / .woff2 and index.html as the default document.
  No double hyphen inside an XML comment: IIS then rejects the whole file.
  Lives in public/ so `vite build` copies it into dist/ every time.
-->
<configuration>
  <system.webServer>
    <!-- users always get the newest index.html (the hashed assets change name on every build) -->
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-cache" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
