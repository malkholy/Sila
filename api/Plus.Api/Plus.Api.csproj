<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UserSecretsId>prov1-general-api-v2</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Setup-IIS.ps1" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../SQLScript/V1ApiAuthSetup.sql" Link="SQL/V1ApiAuthSetup.sql" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../SQLScript/V1ApiOperationPermissions.sql" Link="SQL/V1ApiOperationPermissions.sql" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../IIS-DEPLOYMENT.md" Link="IIS-DEPLOYMENT.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.Sql.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Remove="App_Data/**" />
    <None Remove="App_Data/**" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
  </ItemGroup>
</Project>
