<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UserSecretsId>sila-mail-external-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <!-- Patched transitive dependency of Microsoft.Data.SqlClient (as in SilaApi). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- the publish batch, shared with the Mail Connector API -->
    <Compile Include="../../Shared/PublishContract.cs" Link="Contract/PublishContract.cs" />
    <InternalsVisibleTo Include="Sila.MailExternal.Tests" />
    <!-- the server's secrets: never published or in git -->
    <Content Update="appsettings.External.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Include="../DEPLOY.md" Link="DEPLOY.md" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
