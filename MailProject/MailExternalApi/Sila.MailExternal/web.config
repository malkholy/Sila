<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS host config for the Mail External API (in-process). Publish batches can
  be large (bodies): 64 MB request limit, the app checks the exact size.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Sila.MailExternal.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="67108864" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
