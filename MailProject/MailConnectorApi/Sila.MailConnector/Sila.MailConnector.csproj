<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UserSecretsId>sila-mail-connector-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mail bodies are sanitized before they are stored (Sync/BodySanitizer.cs). MIT licence. -->
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <!-- Patched transitive dependency of Microsoft.Data.SqlClient (as in SilaApi). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sila.MailConnector.Tests" />
    <!-- the publish batch, shared with the Mail External API -->
    <Compile Include="../../Shared/PublishContract.cs" Link="Contract/PublishContract.cs" />
    <Compile Include="../../Shared/MonitorQueries.cs" Link="Contract/MonitorQueries.cs" />
    <None Update="Install-MailConnector.ps1" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../DEPLOY.md" Link="DEPLOY.md" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
    <Content Include="../../Database/Internal/*.sql" LinkBase="SQL" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
    <!-- the service account password: on the server only, never published or in git -->
    <Content Update="appsettings.Exchange.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Exchange.local.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
