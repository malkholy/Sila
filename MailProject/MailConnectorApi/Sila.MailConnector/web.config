<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS host config for the Mail Connector API (in-process). dotnet publish fills
  in the aspNetCore handler details. The API runs background workers (Exchange
  sync, Mail Monitor push), so its pool must stay running: AlwaysRunning, no
  idle timeout, no periodic recycle, preload on (Install-MailConnector.ps1).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Sila.MailConnector.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
