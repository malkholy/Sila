<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UserSecretsId>sila-mail-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <!-- Patched transitive dependency of Microsoft.Data.SqlClient (as in SilaApi). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- the publish batch, shared with the Mail Connector API -->
    <Compile Include="../../Shared/PublishContract.cs" Link="Contract/PublishContract.cs" />
    <Compile Include="../../Shared/MonitorQueries.cs" Link="Contract/MonitorQueries.cs" />
    <InternalsVisibleTo Include="Sila.MailApi.Tests" />
    <!-- the server's secrets: never published or in git -->
    <Content Update="appsettings.Mail.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Remove="App_Data/**" />
    <None Remove="App_Data/**" />
    <Content Include="../DEPLOY.md" Link="DEPLOY.md" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
    <!-- DEPLOY.md step 2: each copy's database scripts travel with the zip -->
    <Content Include="../../Database/Internal/*.sql" LinkBase="SQL/Internal" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
    <Content Include="../../Database/External/*.sql" LinkBase="SQL/External" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
