<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UserSecretsId>sila-general-api-v2</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Setup-IIS.ps1" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../SQLScript/V1ApiTables.sql" Link="SQL/V1ApiTables.sql" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../SQLScript/APIPlusUserOperationV1.sql" Link="SQL/APIPlusUserOperationV1.sql" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../SQLScript/APIPlusAuthSessionOperation.sql" Link="SQL/APIPlusAuthSessionOperation.sql" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../SQLScript/V1ApiOperationPermissionSeed.sql" Link="SQL/V1ApiOperationPermissionSeed.sql" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../docs/IIS-DEPLOYMENT.md" Link="IIS-DEPLOYMENT.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.Sql.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Remove="App_Data/**" />
    <None Remove="App_Data/**" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <!-- Patched transitive dependency of Microsoft.Data.SqlClient (CVE-2026-84008). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
