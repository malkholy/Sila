<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS host config for Plus.Api (in-process). dotnet publish fills in the
  aspNetCore handler details; this file exists for the request limit:
  IIS rejects bodies over ~28.6 MB by default, before the app sees them.
  52428800 (50 MB attachment) + 1 MB form overhead = 53477376; keep it in
  step with Attachments:MaxFileSizeBytes. The app enforces the exact limit.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Plus.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="53477376" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
